#!/usr/bin/env bash

# --- Fish Themes ---
DARK_FISH_THEME="Catppuccin Mocha"
LIGHT_FISH_THEME="Catppuccin Latte"

# --- GTK Themes ---
DARK_GTK_THEME="catppuccin-mocha-lavender-standard+default"
LIGHT_GTK_THEME="catppuccin-latte-lavender-standard+default"

# --- Wallpaper Paths (must be full path) ---
DARK_WALLPAPER_PATH="/usr/share/wallpapers/cachyos-wallpapers/jellyfish.jpg"
LIGHT_WALLPAPER_PATH="$HOME/Downloads/rose-pine-dawn-wallpaper.jpeg"

# --- Waybar Theme ---
DARK_WAYBAR_THEME="mocha.css"
LIGHT_WAYBAR_THEME="latte.css"
WAYBAR_STYLE_PATH="$HOME/.config/waybar/style.css"

# --- Eza Theme ---
DARK_EZA_THEME="$HOME/.config/eza/dark-theme.yml"
LIGHT_EZA_THEME="$HOME/.config/eza/light-theme.yml"
EZA_CONFIG_PATH="$HOME/.config/eza/theme.yml"

# --- GTK Icon Theme ---
DARK_ICON_THEME="Papirus-Dark"
LIGHT_ICON_THEME="Papirus-Light"

# --- Qt 5/6 (Kvantum) Theme ---
DARK_KVANTUM_THEME="catppuccin-mocha-lavender"
LIGHT_KVANTUM_THEME="catppuccin-latte-lavender"

# --- Kitty per-theme rendering profile ---
# Kitty's theme kitten switches colors only.  This companion include lets the
# light theme use a firmer terminal face and an opaque-enough surface without
# changing Mocha's existing presentation.
KITTY_OVERRIDE_PATH="$HOME/.config/kitty/theme-overrides.conf"
TMUX_CATPPUCCIN_SCRIPT="$HOME/.config/tmux/plugins/catppuccin/tmux/catppuccin.tmux"

write_kitty_profile() {
    local profile="$1"
    local temporary_path

    temporary_path="$(mktemp "${KITTY_OVERRIDE_PATH}.XXXXXX")"

    if [ "$profile" = "light" ]; then
        cat > "$temporary_path" <<'EOF'
# Generated by ~/.config/hypr/scripts/theme_toggle -- do not edit.
# Catppuccin Latte: IBM Plex Mono's Nerd-patched family keeps icons aligned.
font_family family="BlexMono Nerd Font Mono" style=Regular
font_size 11.0
text_composition_strategy 1.15
background_opacity 0.90
EOF
    else
        cat > "$temporary_path" <<'EOF'
# Generated by ~/.config/hypr/scripts/theme_toggle -- do not edit.
# Catppuccin Mocha: retain Kitty's normal monospace/font-size defaults.
text_composition_strategy platform
background_opacity 0.70
EOF
    fi

    mv "$temporary_path" "$KITTY_OVERRIDE_PATH"
}

reload_tmux_theme() {
    local flavor="$1"
    local option

    # Tmux survives theme changes.  Catppuccin caches its palette in global
    # @thm_* options, so clear that cache before loading the new flavor.
    tmux has-session 2>/dev/null || return 0

    while IFS= read -r option; do
        tmux set-option -gu "$option"
    done < <(tmux show-options -g | awk '/^@thm_/ { print $1 }')

    tmux set-option -g @catppuccin_flavor "$flavor"
    "$TMUX_CATPPUCCIN_SCRIPT"

    # The plugin regenerates this format on a flavor reload. Restore the
    # leading colored cell so the active tab does not start abruptly at #I.
    tmux set-option -g window-status-current-format \
        '#[fg=#{@thm_crust},bg=#{@thm_mauve}] #I #[fg=#{@thm_fg},bg=#{@thm_surface_1}] #W '
    tmux refresh-client -S
}

# --- Get current desktop color scheme ---
CURRENT_COLOR_SCHEME=$(
    gsettings get org.gnome.desktop.interface color-scheme |
    tr -d "'"
)

# --- Kill existing swaybg process ---
pkill swaybg || true

# --- Toggle between themes ---
if [ "$CURRENT_COLOR_SCHEME" = "prefer-dark" ]; then
    echo "Switching to Light Mode..."

    # 1. Switch GTK + GNOME system color scheme
    gsettings set org.gnome.desktop.interface gtk-theme "$LIGHT_GTK_THEME"
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
    kvantummanager --set "$LIGHT_KVANTUM_THEME" 2>/dev/null || true

    # 2. Tell all Fish sessions about the new global theme
    fish -c 'set -U fish_desktop_theme light'

    # 3. Switch Kitty
    write_kitty_profile light
    kitty +kitten themes --reload-in=all "Catppuccin-Latte"

    # 3a. Hot-reload Catppuccin in the existing tmux server.
    reload_tmux_theme latte

    # 4. Switch Wallpaper
    swaybg -i "$LIGHT_WALLPAPER_PATH" &

    # 5. Switch Waybar
    sed -i "1c\\@import \"$LIGHT_WAYBAR_THEME\";" "$WAYBAR_STYLE_PATH"

    # 6. Switch Eza
    ln -sf "$LIGHT_EZA_THEME" "$EZA_CONFIG_PATH"

    # 7. Switch Icon Theme
    gsettings set org.gnome.desktop.interface icon-theme "$LIGHT_ICON_THEME"

else
    echo "Switching to Dark Mode..."

    # 1. Switch GTK + GNOME system color scheme
    gsettings set org.gnome.desktop.interface gtk-theme "$DARK_GTK_THEME"
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    kvantummanager --set "$DARK_KVANTUM_THEME" 2>/dev/null || true

    # 2. Tell all Fish sessions about the new global theme
    fish -c 'set -U fish_desktop_theme dark'

    # 3. Switch Kitty
    write_kitty_profile dark
    kitty +kitten themes --reload-in=all "Catppuccin-Mocha"

    # 3a. Hot-reload Catppuccin in the existing tmux server.
    reload_tmux_theme mocha

    # 4. Switch Wallpaper
    swaybg -i "$DARK_WALLPAPER_PATH" &

    # 5. Switch Waybar
    sed -i "1c\\@import \"$DARK_WAYBAR_THEME\";" "$WAYBAR_STYLE_PATH"

    # 6. Switch Eza
    ln -sf "$DARK_EZA_THEME" "$EZA_CONFIG_PATH"

    # 7. Switch Icon Theme
    gsettings set org.gnome.desktop.interface icon-theme "$DARK_ICON_THEME"
fi

# Reload running Waybar
pkill -SIGUSR2 -x waybar 2>/dev/null || true
